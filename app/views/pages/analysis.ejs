  <div class="layout-main">
    <div class="layout-three">
      <aside class="left-panel">
        <div class="opening-book-section">
            <h3 class="editor-group-title">Opening Book</h3>
            <div class="opening-book-info" id="openingBookInfo">Not yet available</div>
        </div>
        <div class="engine-panel" id="enginePanel">
          <div class="engine-eval-row">
            <h3 class="editor-group-title">Evaluation</h3>
            <span id="engineEvalScore" class="engine-eval-score">--</span>
            <span id="engineEvalStatus" class="engine-eval-status"></span>
          </div>
          <div class="engine-moves-header">
            <h3 class="editor-group-title">Best Moves</h3>
            <label class="toggle-switch" title="Toggle best-move suggestions">
              <input type="checkbox" id="bestMovesToggle">
              <span class="toggle-switch-slider"></span>
            </label>
          </div>
          <ol id="engineMoveList" class="engine-move-list"></ol>
        </div>
      </aside>
      <main class="center-column">
        <div class="board-wrap">
          <div class="board-toolbar board-nav-toolbar">
            <% if (pageData.gameInfo) { %>
              <% if (pageData.prevGameId) { %>
                <a href="/analysis?gameid=<%= pageData.prevGameId %><%= pageData.eco ? '&eco=' + encodeURIComponent(pageData.eco) : '' %>" class="nav-tool-btn" title="Previous game" aria-label="Previous game">&#171;</a>
              <% } else { %>
                <span class="nav-tool-btn" aria-disabled="true" title="Previous game" aria-label="Previous game">&#171;</span>
              <% } %>
            <% } %>
            <button type="button" id="prevMoveBtn" class="nav-tool-btn" title="Previous move" aria-label="Previous move">&#8249;</button>
            <button type="button" id="nextMoveBtn" class="nav-tool-btn" title="Next move" aria-label="Next move">&#8250;</button>
            <% if (pageData.gameInfo) { %>
              <button type="button" id="playPauseBtn" class="nav-tool-btn" title="Play/pause autoplay" aria-label="Play/pause autoplay">&#9654;</button>
              <% if (pageData.nextGameId) { %>
                <a href="/analysis?gameid=<%= pageData.nextGameId %><%= pageData.eco ? '&eco=' + encodeURIComponent(pageData.eco) : '' %>" class="nav-tool-btn" title="Next game" aria-label="Next game">&#187;</a>
              <% } else { %>
                <span class="nav-tool-btn" aria-disabled="true" title="Next game" aria-label="Next game">&#187;</span>
              <% } %>
            <% } %>
          </div>
          <div class="player-name player-name-top" id="playerNameTop"></div>
          <div class="board-stack">
            <div id="board" class="board-container"></div>
          </div>
          <div class="player-name player-name-bottom" id="playerNameBottom"></div>
        </div>
        <div class="game-info-panel" id="gameInfoPanel">
          <div class="game-info-details" id="gameInfoDetails"></div>
          <div class="game-info-row">
            <div class="game-info-label">FEN:</div>
            <input type="text" id="fenInput" class="editor-text-input fen-input" spellcheck="false" readonly>
            <button type="button" id="copyFenBtn" class="copy-fen-btn" title="Copy FEN" aria-label="Copy FEN">Copy</button>
         </div>
        </div>
      </main>
      <aside class="right-panel">
        <div class="analysis-panel">
          <a href="#" id="linkBackToEditor" class="editor-link">Board editor</a>
          <div id="moveList" class="move-list"></div>
        </div>
      </aside>
    </div>
  </div>

  <script src="/js/board-annotations.js"></script>
  <script src="/js/promotion-layer.js"></script>
  <script src="/js/move-tree.js"></script>
  <script src="/js/move-tree-view.js"></script>
  <script src="/js/choice-modal.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/analysis.chess.js"></script>
