  <div class="layout-main">
    <div class="layout-three">
      <aside class="left-panel">
        <div class="opening-book-section">
            <h3 class="editor-group-title">Opening Book</h3>
            <div class="opening-book-info" id="openingBookInfo">Not yet available</div>
        </div>
        <div class="engine-panel" id="enginePanel">
          <div class="engine-eval-row">
            <h3 class="editor-group-title">Evaluation</h3>
            <span id="engineEvalScore" class="engine-eval-score">--</span>
            <span id="engineEvalStatus" class="engine-eval-status"></span>
          </div>
          <h3 class="editor-group-title">Best Moves</h3>
          <ol id="engineMoveList" class="engine-move-list"></ol>
        </div>
      </aside>
      <main class="center-column">
        <div class="board-wrap">
          <div class="player-name player-name-top" id="playerNameTop"></div>
          <div id="board" class="board-container"></div>
          <div class="player-name player-name-bottom" id="playerNameBottom"></div>
        </div>
        <div class="game-info-panel" id="gameInfoPanel">
          <div class="game-info-details" id="gameInfoDetails"></div>
        </div>
      </main>
      <aside class="right-panel">
        <div class="analysis-panel">
          <a href="#" id="linkBackToEditor" class="editor-link">Board editor</a>
          <div id="moveList" class="move-list"></div>
        </div>
      </aside>
    </div>
    <div class="fen-row">
      <input type="text" id="fenInput" class="editor-text-input fen-input" spellcheck="false" readonly>
    </div>
  </div>

  <script src="/js/board-annotations.js"></script>
  <script src="/js/promotion-layer.js"></script>
  <script src="/js/move-tree.js"></script>
  <script src="/js/move-tree-view.js"></script>
  <script src="/js/choice-modal.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/analysis.chess.js"></script>
