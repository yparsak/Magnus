<%- include('partials/header') %>
  <main class="auth-page">
    <div class="auth-card">
      <%- include('partials/logo') %>
      <h1 class="auth-card-title">Sign Up</h1>

      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <p class="auth-card-error"><%= errorMessage %></p>
      <% } %>

      <form class="auth-form" method="POST" action="/signup">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" minlength="3" maxlength="50" autofocus required
          value="<%= typeof values !== 'undefined' ? values.username : '' %>">
        <p class="auth-card-hint" id="username-availability"></p>

        <label for="email">Email</label>
        <input type="email" id="email" name="email" required
          value="<%= typeof values !== 'undefined' ? values.email : '' %>">

        <label for="password">Password</label>
        <input type="password" id="password" name="password" minlength="9" required>
        <p class="auth-card-hint" id="password-hint"></p>

        <button type="submit" class="submit" id="signup-submit">Continue</button>
      </form>

      <p class="auth-card-hint">Already have an account? <a href="/login" class="link-inherit">Log in</a></p>
    </div>
  </main>
  <script src="/js/signup.js"></script>
<%- include('partials/footer') %>
